<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="FullBackupContent">
    <cloud-backup>
        <include domain="database" path="music_database.db"/>

        <exclude domain="sharedpref" path="artist_signatures.xml"/>
        <exclude domain="sharedpref" path="custom_artist_images.xml"/>
    </cloud-backup>
    <!-- Phone-to-phone transfer copies everything unless excluded: AppSettings.xml holds the
         Spotify/YouTube session cookies and tokens, which must not leave the device. -->
    <device-transfer>
        <exclude domain="sharedpref" path="AppSettings.xml"/>
    </device-transfer>
</data-extraction-rules>
