<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Dark mode always uses pure black surfaces: this overlay is applied
         by AbsThemeActivity whenever the activity resolves to night mode,
         after the selected theme and again after Material You dynamic
         colors (which would otherwise override the black surfaces). -->
    <style name="BlackThemeOverlay">
        <item name="colorSurface">@android:color/black</item>
        <item name="colorSurfaceContainer">@color/surfaceContainerBlack</item>
        <item name="colorSurfaceContainerLow">@color/surfaceContainerLowBlack</item>
        <item name="colorSurfaceContainerLowest">@color/surfaceContainerLowestBlack</item>
        <item name="elevationOverlayColor">@color/elevationOverlayBlack</item>
    </style>

</resources>
