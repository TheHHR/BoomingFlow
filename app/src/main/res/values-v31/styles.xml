<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The Base.Theme.Booming* overrides were removed on purpose: they
         carried NO color roles (upstream expected DynamicColors to always
         inject the wallpaper palette on S+). With "Follow player color"
         suppressing dynamic colors, the theme must fall back to the full
         static md_theme_* palette defined in values/styles_parents.xml -
         keeping the v31 overrides would leave Material baseline colors
         everywhere the accent pipeline does not paint. -->

    <style name="Theme.Booming.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenAnimatedIcon">@drawable/boomingmusic_logo_splash</item>
        <item name="windowSplashScreenBackground">@color/splash_background_color</item>
    </style>

    <style name="Theme.AppWidget" parent="@style/Theme.Material3Expressive.DynamicColors.DayNight"/>

</resources>